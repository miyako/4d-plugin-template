name: Build

on:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: signed-packages-${{ github.ref }}
  cancel-in-progress: false

jobs:
  authorize:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.sha }}
          submodules: recursive
          fetch-depth: 0
      - name: Verify pipeline ownership
        run: python3 scripts/check_pipeline.py
      - name: Require an explicit default-branch dispatch
        env:
          DEFAULT_BRANCH: ${{ github.event.repository.default_branch }}
        run: |
          set -euo pipefail
          [ "$GITHUB_EVENT_NAME" = workflow_dispatch ]
          [ "$DEFAULT_BRANCH" = '@@RELEASE_BRANCH@@' ]
          [ "$GITHUB_REF" = 'refs/heads/@@RELEASE_BRANCH@@' ]
      - name: Preflight immutable source and release availability
        env:
          GH_TOKEN: ${{ github.token }}
        run: python3 scripts/publish_release.py --preflight
  build:
    needs: authorize
    if: github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/@@RELEASE_BRANCH@@'
    uses: ./.github/workflows/test.yml
  sign-package:
    needs: build
    if: github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/@@RELEASE_BRANCH@@'
    runs-on: macos-latest
    environment: @@SIGNING_ENVIRONMENT@@
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.sha }}
          submodules: recursive
          fetch-depth: 0
      - name: Verify pipeline ownership
        run: python3 scripts/check_pipeline.py
      - uses: actions/download-artifact@v4
        with:
          name: native-macos-${{ github.sha }}
          path: .package-inputs/macos
      - uses: actions/download-artifact@v4
        with:
          name: native-windows-${{ github.sha }}
          path: .package-inputs/windows
      - name: Assemble verified source-bound inputs
        run: python3 scripts/package.py assemble --inputs .package-inputs --output .release-package
      - name: Developer ID sign, notarize, and package
        id: sign
        env:
          APPLE_DEVELOPER_ID_CERTIFICATE: ${{ secrets.APPLE_DEVELOPER_ID_CERTIFICATE }}
          APPLE_DEVELOPER_ID_CERTIFICATE_PASSWORD: ${{ secrets.APPLE_DEVELOPER_ID_CERTIFICATE_PASSWORD }}
          KEYCHAIN_PASSWORD: ${{ secrets.KEYCHAIN_PASSWORD }}
          NOTARYTOOL_APPLE_ID: ${{ secrets.NOTARYTOOL_APPLE_ID }}
          NOTARYTOOL_TEAM_ID: ${{ secrets.NOTARYTOOL_TEAM_ID }}
          NOTARYTOOL_PASSWORD: ${{ secrets.NOTARYTOOL_PASSWORD }}
        run: bash scripts/sign-package.sh .release-package/payload .signed-distribution
      - name: Retain notarization failure diagnostics
        if: failure() && steps.sign.outcome == 'failure'
        uses: actions/upload-artifact@v4
        with:
          name: notarization-failure-${{ github.sha }}
          path: .signed-distribution/*-notarization*.json
          include-hidden-files: true
          if-no-files-found: ignore
          retention-days: 7
      - name: Reverify distribution and install verified ZIP for smoke testing
        run: |
          set -euo pipefail
          python3 scripts/verify_distribution.py --directory .signed-distribution --output .signed-extracted
          mkdir -p @@TEST_ROOT@@/Plugins
          [ ! -e "@@TEST_ROOT@@/Plugins/@@PRODUCT@@.bundle" ]
          [ ! -L "@@TEST_ROOT@@/Plugins/@@PRODUCT@@.bundle" ]
          ditto .signed-extracted/@@PRODUCT@@.bundle @@TEST_ROOT@@/Plugins/@@PRODUCT@@.bundle
      - name: Smoke test the signed packaged plugin
        uses: ./.github/actions/tool4d-test
        with:
          project: @@TEST_PROJECT@@
          startup_method: @@STARTUP_METHOD@@
      - uses: actions/upload-artifact@v4
        with:
          name: @@PRODUCT@@-signed-packages-${{ github.sha }}
          path: .signed-distribution/
          include-hidden-files: true
          if-no-files-found: error
          retention-days: 14
  publish:
    needs: sign-package
    runs-on: macos-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.sha }}
          submodules: recursive
          fetch-depth: 0
      - name: Verify pipeline ownership
        run: python3 scripts/check_pipeline.py
      - uses: actions/download-artifact@v4
        with:
          name: @@PRODUCT@@-signed-packages-${{ github.sha }}
          path: .signed-distribution
      - name: Publish tag-bound draft after checking uploaded checksums
        env:
          GH_TOKEN: ${{ github.token }}
        run: python3 scripts/publish_release.py --directory .signed-distribution --output .publish-extracted
